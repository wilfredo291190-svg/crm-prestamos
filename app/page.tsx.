'use client';

import React, { useState } from 'react';

export default function Home() {
  const [monto, setMonto] = useState(1000);
  const [tasa, setTasa] = useState(5);
  const [pago, setPago] = useState(0);

  const interesCalculado = (monto * tasa) / 100;
  const pagoAInteres = Math.min(pago, interesCalculado);
  const pagoACapital = Math.max(0, pago - interesCalculado);
  const nuevoSaldo = monto - pagoACapital;

  return (
    <div className="min-h-screen bg-slate-900 text-white p-6 font-sans">
      <div className="max-w-4xl mx-auto space-y-6">
        <h1 className="text-3xl font-bold text-sky-400">CRM Préstamos - Prototipo $0</h1>
        
        {/* Tarjetas Resumen */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="bg-slate-800 p-4 rounded-xl border border-slate-700">
            <p className="text-slate-400 text-sm font-semibold">Capital Pendiente</p>
            <p className="text-2xl font-bold text-white">${monto.toFixed(2)}</p>
          </div>
          <div className="bg-slate-800 p-4 rounded-xl border border-slate-700">
            <p className="text-slate-400 text-sm font-semibold">Interés Quincenal ({tasa}%)</p>
            <p className="text-2xl font-bold text-amber-400">${interesCalculado.toFixed(2)}</p>
          </div>
          <div className="bg-slate-800 p-4 rounded-xl border border-slate-700">
            <p className="text-slate-400 text-sm font-semibold">Nuevo Saldo Capital</p>
            <p className="text-2xl font-bold text-emerald-400">${nuevoSaldo.toFixed(2)}</p>
          </div>
        </div>

        {/* Formularios de Prueba */}
        <div className="bg-slate-800 p-6 rounded-xl border border-slate-700 space-y-4">
          <h2 className="text-xl font-bold text-slate-200">Simulador de Cobro y Prelación</h2>
          
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label className="block text-sm text-slate-400 mb-1">Monto Préstamo ($)</label>
              <input 
                type="number" 
                value={monto} 
                onChange={(e) => setMonto(Number(e.target.value))}
                className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white"
              />
            </div>
            <div>
              <label className="block text-sm text-slate-400 mb-1">Tasa Quincenal (%)</label>
              <input 
                type="number" 
                value={tasa} 
                onChange={(e) => setTasa(Number(e.target.value))}
                className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white"
              />
            </div>
            <div>
              <label className="block text-sm text-slate-400 mb-1">Monto Abonado por Cliente ($)</label>
              <input 
                type="number" 
                value={pago} 
                onChange={(e) => setPago(Number(e.target.value))}
                className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white"
              />
            </div>
          </div>

          <div className="bg-slate-900 p-4 rounded-lg space-y-2 border border-slate-700/50">
            <p className="text-sm font-semibold text-slate-300">Desglose Automático del Pago:</p>
            <p className="text-sm text-amber-300">Abono aplicado a Interés: <strong>${pagoAInteres.toFixed(2)}</strong></p>
            <p className="text-sm text-emerald-300">Abono aplicado a Capital: <strong>${pagoACapital.toFixed(2)}</strong></p>
          </div>
        </div>
      </div>
    </div>
  );
}
